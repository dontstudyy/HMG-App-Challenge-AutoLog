{
  "packageName": "com.dontstudyy.autolog",
  "appDescription": "오토로그: 업무 운행을 자동으로 기록하는 앱",
  "version": "1.0",
  "actionCalls": [
    {
      "component": "activity",
      "name": "LOG_TRIP_PURPOSE",
