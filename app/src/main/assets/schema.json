        { "name": "purpose", "type": "string", "description": "운행 목적 (예: 거래처 미팅)", "required": true }
      ]
    },
    {
      "component": "activity",
      "name": "START_PRIVATE_TRIP",
      "description": "이번 운행을 개인 용무로 기록한다",
